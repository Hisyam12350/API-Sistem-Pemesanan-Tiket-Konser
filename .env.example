# ===== Supabase =====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://xxxx.supabase.co/auth/v1/.well-known/jwks.json

# ===== JWT =====
# WAJIB untuk produksi: gunakan string acak yang panjang & rahasia
JWT_SECRET=ganti_dengan_string_acak_yang_panjang_dan_rahasia
JWT_EXPIRES_IN=1d

# ===== Database (opsional, untuk fitur transaksional via pg) =====
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ===== Server =====
PORT=5000
