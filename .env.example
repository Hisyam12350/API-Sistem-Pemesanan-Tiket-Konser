# ===== Supabase =====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://xxxx.supabase.co/auth/v1/.well-known/jwks.json

# ===== JWT =====
# WAJIB (server menolak start bila kosong / terlalu pendek / masih nilai contoh).
# Minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ===== Database (opsional, untuk fitur transaksional via pg) =====
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ===== Midtrans =====
MIDTRANS_SERVER_KEY=SB-Mid-server-xxx
MIDTRANS_CLIENT_KEY=Mid-client-xxx
MIDTRANS_SIGNATURE_KEY=SB-Mid-server-xxx
MIDTRANS_IS_PRODUCTION=false

# ===== Server =====
PORT=5000

# Development default. Set production only in a production deployment.
NODE_ENV=development
# Jumlah reverse proxy di depan server (default 1 di production, nonaktif di development)
TRUST_PROXY=1

# ===== Aturan bisnis (opsional, ini nilai default) =====
MAX_SEATS_PER_ORDER=6
ORDER_PAYMENT_MINUTES=15
DEFAULT_LOCK_MINUTES=15
MAX_LOCK_MINUTES=60
CHECKIN_OPENS_HOURS_BEFORE=6
CHECKIN_CLOSES_HOURS_AFTER=12

# ===== SSL database =====
# With DATABASE_URL, TLS is used. Certificate verification defaults to ON in production and OFF otherwise.
# In production, set DB_SSL_CA to the trusted database CA (newlines may be written as \n).
# DB_SSL_REJECT_UNAUTHORIZED=true also enables verification in development/test.
# Temporary compatibility override only: DB_SSL_REJECT_UNAUTHORIZED=false disables verification.
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=false
